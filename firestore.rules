rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Users can read and write their own profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // 2. Wallets: Users can READ their balance, but CANNOT WRITE to it directly.
    // Only the admin backend can change money.
    match /wallets/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false; 
    }

    // 3. Deposit Requests: Users can create a request (must be "pending") and read their own.
    // They CANNOT approve or change it once submitted.
    match /depositRequests/{requestId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.status == "pending" && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false; 
    }

    // 4. Withdrawal Requests: Same as deposits.
    match /withdrawalRequests/{requestId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.status == "pending" && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
