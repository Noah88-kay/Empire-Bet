# --- Core ---
API_PORT=4000
NODE_ENV=development
# SQLite for local dev. For production switch the provider in prisma/schema.prisma to "postgresql"
# and use e.g. postgresql://user:pass@host:5432/empirebet
DATABASE_URL="file:./dev.db"
WEB_ORIGIN=http://localhost:5173

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh

# Withdrawals at or below this amount (KES) are paid automatically when KYC is verified.
AUTO_APPROVE_WITHDRAWAL_KES=20000
# Tax withheld from winnings (0.20 = 20%). Confirm current KRA/BCLB rules before going live.
WINNINGS_TAX_RATE=0

# --- M-Pesa (Daraja) ---
# mock = no network, callbacks are simulated after a few seconds (local dev)
# sandbox / production = real Daraja calls
MPESA_MODE=mock
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_B2C_SHORTCODE=
MPESA_B2C_INITIATOR=
MPESA_B2C_SECURITY_CREDENTIAL=
# Public https base URL Daraja can reach, e.g. https://api.empirebet.co.ke
MPESA_CALLBACK_BASE_URL=
# Random string; becomes part of the callback path so callbacks can't be guessed.
MPESA_CALLBACK_SECRET=change-me-callback

# --- SMS ---
# console = codes only printed in the server log, and sign-up needs no code.
# africastalking = real SMS; phone codes are then required. Needs AT_USERNAME + AT_API_KEY ("sandbox" username for tests).
SMS_MODE=console
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=

# --- Live sports feed ---
# espn = real fixtures, live scores, results and pre-match 1X2 odds (public, unofficial; dev/testing).
# off  = no feed; events are entered and settled by hand in the back office.
FEED_MODE=espn
FEED_LEAGUES=eng.1,esp.1,ita.1,ger.1,fra.1,uefa.champions,uefa.europa,ken.1
FEED_DAYS_AHEAD=7
FEED_LIVE_INTERVAL_S=30
FEED_FULL_INTERVAL_S=600
